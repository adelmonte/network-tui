# Maintainer: adelmonte
pkgname=network-tui
pkgver=0.2.1
pkgrel=1
pkgdesc='Network manager with a terminal UI: Wi-Fi via iwd, Ethernet, WireGuard, OpenVPN'
arch=('x86_64')
url='https://github.com/adelmonte/network-tui'
license=('GPL-3.0-or-later')
depends=('iwd' 'gcc-libs' 'glibc')
optdepends=('nftables: sharing a connection over a hotspot'
            'openvpn: OpenVPN connections')
backup=('etc/iwd/main.conf')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('26e2741a801d6fcdba7d01eeac8119b55f279322950f6ff82ac229a661a406a1')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/${CARGO_BUILD_TARGET:-.}/release/network-tui "$pkgdir/usr/bin/network-tui"
  install -Dm644 packaging/network-tui.toml "$pkgdir/usr/lib/supervisor/network-tui.toml"
  install -Dm644 packaging/network-tui.service "$pkgdir/usr/lib/systemd/system/network-tui.service"
  install -Dm644 packaging/iwd-main.conf "$pkgdir/etc/iwd/main.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
